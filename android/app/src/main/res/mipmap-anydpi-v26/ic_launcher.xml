<!--
  File Purpose: Composes Attractive's adaptive launcher icon for all supported Android versions.
  Primary Components: Dark background plus orbit foreground and monochrome layer.
  Inputs/Outputs: Used by launchers through AndroidManifest icon metadata.
-->
<adaptive-icon
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="ObsoleteSdkInt">
    <background android:drawable="@color/attractive_icon_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
