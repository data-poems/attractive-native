default_platform(:ios)

# Auth: deliver/spaceship auto-detect the App Store Connect API key from
# APP_STORE_CONNECT_API_KEY_KEY_ID / _ISSUER_ID / _KEY
# (run `source ~/.appstoreconnect/env.sh` first).

platform :ios do
  desc "Report the iOS app's versions, states, and latest TestFlight build"
  lane :inspect do
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_KEY"],
      is_key_content_base64: false
    )
    app = Spaceship::ConnectAPI::App.find("com.lukesteuber.attractive")
    UI.success("App: #{app.name}  (#{app.bundle_id})")
    app.get_app_store_versions(filter: { platform: "IOS" }).sort_by(&:version_string).each do |v|
      UI.message("  version #{v.version_string} — #{v.app_store_state}")
    end
  end

  desc "Upload the iOS listing metadata (no binary, no screenshots, no submit)"
  lane :upload_listing do
    deliver(
      app_identifier: "com.lukesteuber.attractive",
      app_version: "1.0",
      metadata_path: "./fastlane/metadata",
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_app_version_update: true,
      force: true,
      run_precheck_before_submit: false,
      submit_for_review: false,
      automatic_release: false
    )
  end

  desc "Report screenshot + metadata coverage for the editable iOS version"
  lane :shots do
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_KEY"],
      is_key_content_base64: false
    )
    app = Spaceship::ConnectAPI::App.find("com.lukesteuber.attractive")
    v = app.get_app_store_versions(filter: { platform: "IOS" }).find { |x| x.app_store_state == "PREPARE_FOR_SUBMISSION" } ||
        app.get_app_store_versions(filter: { platform: "IOS" }).first
    loc = v.get_app_store_version_localizations.find { |l| l.locale == "en-US" } || v.get_app_store_version_localizations.first
    UI.success("version #{v.version_string} (#{v.app_store_state}), locale #{loc.locale}")
    UI.message("  description: #{loc.description.to_s.length} chars, keywords: #{loc.keywords.to_s.length} chars")
    sets = loc.get_app_screenshot_sets
    if sets.empty?
      UI.important("  NO screenshots on this version")
    else
      sets.each { |s| UI.message("  #{s.screenshot_display_type}: #{s.app_screenshots.count} screenshots") }
    end
  end

  desc "Upload App Store screenshots (the macOS-rendered attractor cards)"
  lane :upload_screenshots do
    staged = File.expand_path("../build/screenshots/en-US", __dir__)
    FileUtils.rm_rf(staged)
    FileUtils.mkdir_p(staged)
    { "iphone-6.9" => "iphone69", "ipad-13" => "ipad13" }.each do |src, prefix|
      Dir[File.expand_path("../screenshots-appstore/#{src}/0[1-9]-*.png", __dir__)].sort.each do |f|
        FileUtils.cp(f, File.join(staged, "#{prefix}-#{File.basename(f)}"))
      end
    end
    deliver(
      app_identifier: "com.lukesteuber.attractive",
      app_version: "1.0",
      screenshots_path: File.expand_path("../build/screenshots", __dir__),
      overwrite_screenshots: true,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_app_version_update: true,
      force: true,
      run_precheck_before_submit: false,
      submit_for_review: false,
      automatic_release: false
    )
  end

  desc "Verify + dedup screenshots (deliver's read-back race can duplicate them)"
  lane :dedup_shots do
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_KEY"],
      is_key_content_base64: false
    )
    app = Spaceship::ConnectAPI::App.find("com.lukesteuber.attractive")
    v = app.get_app_store_versions(filter: { platform: "IOS" }).find { |x| x.app_store_state == "PREPARE_FOR_SUBMISSION" } ||
        app.get_app_store_versions(filter: { platform: "IOS" }).first
    loc = v.get_app_store_version_localizations.find { |l| l.locale == "en-US" } || v.get_app_store_version_localizations.first
    loc.get_app_screenshot_sets.each do |set|
      seen = {}
      set.app_screenshots.each do |sh|
        if seen[sh.file_name]
          UI.message("  dupe → delete #{set.screenshot_display_type} #{sh.file_name}")
          sh.delete!
        else
          seen[sh.file_name] = true
        end
      end
      UI.success("#{set.screenshot_display_type}: #{seen.size} unique")
    end
  end

  desc "Set first-version app-info (subtitle + categories) directly — deliver can't on a first version"
  lane :prepare_app_info do
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_KEY"],
      is_key_content_base64: false
    )
    app = Spaceship::ConnectAPI::App.find("com.lukesteuber.attractive")
    info = app.fetch_edit_app_info
    UI.user_error!("no editable AppInfo found") unless info
    UI.message("AppInfo #{info.id} state #{info.app_store_state}")

    loc = info.get_app_info_localizations.find { |l| l.locale == "en-US" } || info.get_app_info_localizations.first
    loc.update(attributes: {
      subtitle: "Chaos & strange attractors",
      privacyPolicyUrl: "https://dr.eamer.dev/attractive/privacy.html",
    })
    UI.success("subtitle + privacy URL set on #{loc.locale}")

    info.update_categories(category_id_map: {
      primary_category_id: "EDUCATION",
      secondary_category_id: "GRAPHICS_AND_DESIGN",
    })
    UI.success("categories set: Education / Graphics & Design")
  end

  desc "Attach the latest processed build to the editable iOS version"
  lane :select_latest_build do
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_KEY"],
      is_key_content_base64: false
    )
    app = Spaceship::ConnectAPI::App.find("com.lukesteuber.attractive")
    v = app.get_app_store_versions(filter: { platform: "IOS" }).find { |x| x.app_store_state == "PREPARE_FOR_SUBMISSION" }
    build = app.get_builds.max_by { |b| b.version.to_i }
    UI.user_error!("no builds found") unless build
    v.select_build(build_id: build.id)
    UI.success("selected build #{build.version} for version #{v.version_string}")
  end

  desc "Pre-submission audit: report every required field's presence"
  lane :audit do
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_KEY"],
      is_key_content_base64: false
    )
    app = Spaceship::ConnectAPI::App.find("com.lukesteuber.attractive")
    info = app.fetch_edit_app_info
    iloc = info.get_app_info_localizations.find { |l| l.locale == "en-US" }
    UI.message("name           : #{iloc.name}")
    UI.message("subtitle       : #{iloc.subtitle}")
    UI.message("privacy URL    : #{iloc.privacy_policy_url}")
    UI.message("primary cat    : #{info.primary_category&.id}")
    UI.message("secondary cat  : #{info.secondary_category&.id}")
    ard = (info.fetch_age_rating_declaration rescue nil)
    UI.message("age rating     : #{ard ? 'present' : 'MISSING'}")
    v = app.get_app_store_versions(filter: { platform: "IOS" }).find { |x| x.app_store_state == "PREPARE_FOR_SUBMISSION" }
    vloc = v.get_app_store_version_localizations.find { |l| l.locale == "en-US" }
    UI.message("version        : #{v.version_string} (#{v.app_store_state})")
    UI.message("description    : #{vloc.description.to_s.length} chars")
    UI.message("keywords       : #{vloc.keywords.to_s.length} chars")
    UI.message("promo text     : #{vloc.promotional_text.to_s.length} chars")
    UI.message("support URL    : #{vloc.support_url}")
    vloc.get_app_screenshot_sets.each { |s| UI.message("screenshots    : #{s.screenshot_display_type} = #{s.app_screenshots.count}") }
    b = (v.build rescue nil)
    UI.message("selected build : #{b&.version || 'none (select after processing)'}")
  end
end
